ALTER TABLE pet_vacinas
    DROP CHECK chk_pet_vacinas_status_datas,
    ADD CONSTRAINT chk_pet_vacinas_status_datas
        CHECK (
            (status = 'prevista' AND data_prevista IS NOT NULL AND data_aplicacao IS NULL)
            OR status = 'aplicada'
        );

CREATE TABLE pet_vacina_catalogo (
    pet_id BIGINT NOT NULL,
    vacina_key VARCHAR(40) NOT NULL,
    status ENUM('aplicada', 'nao_aplicada', 'desconhecida') NOT NULL,
    data_aplicacao DATE NULL,
    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
    PRIMARY KEY (pet_id, vacina_key),
    CONSTRAINT chk_pet_vacina_catalogo_data
        CHECK (status = 'aplicada' OR data_aplicacao IS NULL),
    CONSTRAINT fk_pet_vacina_catalogo_pet
        FOREIGN KEY (pet_id)
        REFERENCES pets (id)
        ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;
